{
  "name": "salman-kinetic-garden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @garden/web dev",
    "dev:stop": "pnpm --filter @garden/web exec astro dev stop",
    "ports:free": "node tooling/scripts/free-ports.mjs",
    "build": "pnpm --filter @garden/web build && node tooling/scripts/stage-site.mjs",
    "deploy:prepare": "pnpm build && pnpm budget",
    "check": "pnpm --filter @garden/web check && pnpm --filter @garden/cms check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cms:dev": "pnpm --filter @garden/cms dev",
    "cms:build": "pnpm --filter @garden/cms build",
    "cms:start": "pnpm --filter @garden/cms start",
    "start": "pnpm --filter @garden/web start",
    "cms:seed": "pnpm --filter @garden/cms seed",
    "cms:migrate": "pnpm --filter @garden/cms migrate",
    "cms:reset": "pnpm --filter @garden/cms reset",
    "cms:seed:all": "pnpm --filter @garden/cms seed:all",
    "cmd:import:map": "pnpm --filter @garden/cms generate:importmap",
    "cms:doctor": "node tooling/scripts/cms-doctor.mjs",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx,yml,yaml}\"",
    "budget": "node tooling/scripts/check-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
