---
import type { Profile } from "@garden/content-schema";
import { contactLinks } from "../lib/contact";
import Icon from "./Icon.astro";
const { profile } = Astro.props as { profile: Profile };
const links = contactLinks(profile);
---

<div
  class="contact-channels"
  role="group"
  aria-label={`Ways to contact ${profile.name.split(" ")[0]}`}
>
  <a
    class="contact-channel channel-primary"
    href={links.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="channel-heading"
      ><Icon name="message" size={22} /><strong>WhatsApp</strong
      ><span class="channel-tag">MESSAGE ME</span></span
    >
    <span class="channel-address">{profile.collaboration.whatsappNumber}</span>
    <span class="channel-action"
      >Start a conversation <Icon name="diagonal" size={18} /></span
    >
  </a>
  <a class="contact-channel" href={links.call}>
    <span class="channel-heading"
      ><Icon name="phone" size={22} /><strong>Phone</strong></span
    >
    <span class="channel-address">{profile.collaboration.callNumber}</span>
    <span class="channel-action"
      >Call me <Icon name="diagonal" size={18} /></span
    >
  </a>
  <div class="contact-channel channel-email">
    <span class="channel-heading"
      ><Icon name="mail" size={22} /><strong>Email</strong></span
    >
    <a class="channel-address" href={links.email}>{profile.email}</a>
    <div class="channel-email-actions">
      <a href={links.email}>Send an email <Icon name="diagonal" size={18} /></a>
      <button data-copy={profile.email} aria-label="Copy email address">
        Copy
      </button>
    </div>
  </div>
</div>
