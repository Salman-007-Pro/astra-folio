---
import type { Profile } from "@garden/content-schema";
import Icon from "./Icon.astro";
import ContactChannels from "./ContactChannels.astro";
const { profile } = Astro.props as { profile: Profile };
---

<section class="section contact-section" id="contact" data-chapter="CONTACT">
  <div class="eyebrow">
    <span class="section-number">06 /</span>
    THE NEXT CONNECTION
  </div>
  <div class="contact-headline">
    <h2>Something complex<br>on your mind?</h2>
    <a
      href="/contact"
      class="contact-orb"
      aria-label={`Contact ${profile.name.split(" ")[0]}`}
      ><Icon name="diagonal" size={58} /></a
    >
  </div>
  <p class="contact-invitation">
    Remote full-stack engineering for teams anywhere in the world.
  </p>
  <ContactChannels profile={profile} />
  <div class="contact-footer">
    <p>
      {profile.collaboration.availability}<span
        >Open to opportunities paid in {profile.collaboration.currencies}.</span
      >
    </p>
    <div class="contact-socials">
      <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a
      ><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a
      ><a href="/cv">View CV ↗</a>
    </div>
  </div>
</section>
