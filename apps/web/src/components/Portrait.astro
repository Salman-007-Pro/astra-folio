---
import { Picture } from "astro:assets";
import portrait from "../assets/salman-asif-portrait.png";

interface Props {
  name: string;
  priority?: boolean;
}

const { name, priority = false } = Astro.props;
---

<figure class="portrait">
  <div class="portrait-frame">
    <Picture
      src={portrait}
      alt={`Professional portrait of ${name}`}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[400, 640, 960]}
      sizes="(max-width: 767px) 88vw, (max-width: 1100px) 38vw, 460px"
      width={960}
      quality={85}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  </div>
  <figcaption>
    <strong>{name}</strong>
    <span>Full-stack engineer</span>
  </figcaption>
</figure>

<style>
  .portrait {
    width: 100%;
    max-width: 460px;
    margin: 0;
  }
  .portrait-frame {
    padding: 8px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: 10px;
    box-shadow: 0 16px 48px rgb(23 37 34 / 7%);
  }
  .portrait-frame :global(picture) {
    display: block;
  }
  .portrait-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: 4px;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 18px 2px 0;
  }
  figcaption strong {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  figcaption span {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  @media (max-width: 767px) {
    .portrait {
      max-width: 400px;
      margin-inline: auto;
    }
  }
</style>
