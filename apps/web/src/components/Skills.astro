---
import type { Project, TechLabSettings } from "@garden/content-schema";
const { projects, settings } = Astro.props as {
  projects: Project[];
  settings: TechLabSettings;
};
const categories = [...new Set(settings.technologies.map((t) => t.category))];
---

<div class="reading-toolkit">
  {categories.map(category => <section><h3>{category}</h3><p>{settings.technologies.filter(t => t.category === category).map(t => t.name).join(" · ")}</p></section>)}
  <h3>System design</h3>
  {settings.scenarios.map(s => <section><h4>{s.title}</h4><p>{s.explanation} {s.why}</p></section>)}
  <h3>Selected evidence</h3>
  <div class="lab-evidence">
    {projects.filter(p => settings.technologies.some(t => t.projects.includes(p.slug))).map(p => <a href={`/work/${p.slug}`}>{p.shortTitle} ↗</a>)}
  </div>
</div>
