---
import Shell from "../layouts/Shell.astro";
import Icon from "../components/Icon.astro";
import Garden from "../experience/Garden";
import ProjectGrid from "../components/ProjectGrid.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import WritingList from "../components/WritingList.astro";
import ContactBlock from "../components/ContactBlock.astro";
import WorkBiome from "../components/WorkBiome.astro";
import Portrait from "../components/Portrait.astro";
import Arcade from "../games/Arcade";
import { getContent } from "../lib/content";
const { profile, projects, experience, posts, site } = await getContent();
---

<Shell immersive>
  <Garden
    client:idle
    title={site.title}
    projects={projects.filter(p => p.featured).map(({slug, shortTitle, preset}) => ({slug, shortTitle, preset}))}
  />
  <section class="hero" id="home" data-chapter="HERO">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="line"></span>
        {site.hero.eyebrow}
      </div>
      <h1>{site.hero.title}<br><em>{site.hero.accent}</em></h1>
      <p class="hero-description">{site.hero.description}</p>
      <a class="hero-availability" href="/contact"
        ><Icon name="globe" size={16} />
        {profile.collaboration.availability}<Icon
          name="diagonal"
          size={14}
        /></a
      >
      <div class="hero-ctas">
        <a class="button" href="#work"
          >Explore my work <Icon name="arrow" size={18} /></a
        ><a class="text-link" href="/cv"
          >View my CV <Icon name="diagonal" size={16} /></a
        >
      </div>
    </div>
    <div class="hero-scene-slot" data-hero-world-mount aria-hidden="true"></div>
    <div class="hero-bottom">
      <div class="location">
        <Icon name="globe" size={15} />
        {site.locationShort}
      </div>
      <div>
        <span>FROM THE INTERFACE TO THE INFRASTRUCTURE.</span>
      </div>
      <div>SCROLL TO EXPLORE <Icon name="down" size={15} /></div>
    </div>
  </section>
  <div class="proof-strip">
    <span>ENGINEERING ACROSS THE STACK</span>
    <div>Vue / React</div>
    <i>✳</i>
    <div>Go / Python</div>
    <i>✳</i>
    <div>React Native</div>
    <i>✳</i>
    <div>Cloud & delivery</div>
  </div>
  <section class="section" id="work" data-chapter="WORK">
    <div class="section-header">
      <div>
        <div class="eyebrow">
          <span class="section-number">01 /</span>
          SELECTED WORK
        </div>
        <h2>Built for the<br>beautifully complex.</h2>
      </div>
      <p>
        Enterprise systems, mobile products, and the engineering decisions that
        make them work.
      </p>
      <a href="/work" class="text-link"
        >All selected work <Icon name="diagonal" size={16} /></a
      >
    </div>
    <WorkBiome projects={projects} />
    <ProjectGrid projects={projects.filter((p) => p.featured)} />
  </section>
  <section
    class="section experience-section"
    id="experience"
    data-chapter="EXPERIENCE"
  >
    <div class="section-header">
      <div>
        <div class="eyebrow">
          <span class="section-number">02 /</span>
          THE JOURNEY SO FAR
        </div>
        <h2>Built things.<br>Learned things. Repeat.</h2>
      </div>
      <p>
        From early startup releases to enterprise systems. Every chapter adds a
        different kind of perspective.
      </p>
    </div>
    <Experience items={experience} />
  </section>
  <section class="section" id="skills" data-chapter="SKILLS">
    <div class="section-header">
      <div>
        <div class="eyebrow">
          <span class="section-number">03 /</span>
          A CONNECTED TOOLKIT
        </div>
        <h2>The right tools.<br>The whole picture.</h2>
      </div>
      <p>
        Technologies matter most when they solve something. Follow a connection
        to see them in context.
      </p>
    </div>
    <Skills projects={projects} />
  </section>
  <section class="section writing-section" id="writing" data-chapter="WRITING">
    <div class="section-header">
      <div>
        <div class="eyebrow">
          <span class="section-number">04 /</span>
          THE OBSERVATORY
        </div>
        <h2>Field notes<br>from the build.</h2>
      </div>
      <a class="text-link" href="/writing"
        >All writing <Icon name="diagonal" size={16} /></a
      >
    </div>
    <WritingList posts={posts} />
  </section>
  <section class="section about-section" id="about" data-chapter="ABOUT">
    <div class="eyebrow">
      <span class="section-number">05 /</span>
      THE HUMAN IN THE SYSTEM
    </div>
    <div class="about-layout">
      <Portrait
        name={profile.name}
        file={site.portrait.file}
        caption={site.portrait.caption}
      />
      <div class="about-copy">
        <h2>Curious by default.<br>An engineer<br><em>by practice.</em></h2>
        <p class="large-copy">{site.about.teaser}</p>
        <p>{site.about.summary}</p>
        <a class="text-link" href="/about"
          >A little more about me <Icon name="diagonal" size={16} /></a
        >
      </div>
    </div>
  </section>
  {site.games.enabled && <section class="section arcade-section" id="play" aria-label="The garden arcade">
    <div class="section-header"><div><div class="eyebrow">THE PLAYGROUND</div><h2>{site.games.title}</h2></div><p>{site.games.intro}</p><a href="/play" class="text-link">Open arcade <Icon name="diagonal" size={16} /></a></div>
    <Arcade client:visible settings={site.games} />
    <noscript><p>Enable JavaScript to play these games. The rest of the portfolio is available without it.</p></noscript>
  </section>}
  <ContactBlock profile={profile} />
</Shell>
