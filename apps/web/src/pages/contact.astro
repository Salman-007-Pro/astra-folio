---
import Shell from "../layouts/Shell.astro";
import Icon from "../components/Icon.astro";
import ContactChannels from "../components/ContactChannels.astro";
import { getContent } from "../lib/content";
const { profile } = await getContent();
---

<Shell
  title={`Let’s talk — ${profile.name}`}
  description={`Hire ${profile.name}. ${profile.collaboration.availability}. Get in touch by WhatsApp, phone, or email.`}
  ><section class="page-intro contact-page">
    <div class="contact-intro-grid">
      <div>
        <div class="eyebrow">LET’S BUILD SOMETHING THAT MATTERS</div>
        <h1>Your next build.<br>My kind of <em>challenge.</em></h1>
        <p class="contact-introduction">
          A product to bring to life. A system to make more reliable. A team
          that needs someone who can connect the whole stack. Let’s talk about
          where I can help.
        </p>
      </div>
      <aside class="collaboration-panel" aria-label="Work availability">
        <div class="collaboration-panel-top">
          <Icon name="globe" size={26} /><span>OPEN TO OPPORTUNITIES</span>
        </div>
        <h2>Great work.<br><em>Across borders.</em></h2>
        <p>{profile.collaboration.summary}</p>
        <dl>
          <div>
            <dt>Working model</dt>
            <dd>{profile.collaboration.availability}</dd>
          </div>
          <div>
            <dt>Preferred compensation</dt>
            <dd>{profile.collaboration.currencies}</dd>
          </div>
        </dl>
      </aside>
    </div>
    <ContactChannels profile={profile} />
    <div class="contact-brief">
      <p>
        Tell me a little about the role or project, your budget, and your team’s
        working hours.
      </p>
      <a class="text-link" href="/cv"
        >View my CV <Icon name="diagonal" size={16} /></a
      >
    </div>
  </section>
  <div class="contact-details page-content">
    <div>
      <span class="eyebrow">LOCAL CONNECTIONS</span>
      <h3>{profile.collaboration.locations}</h3>
      <p>Remote worldwide, on-site, or relocation for the right opportunity.</p>
    </div>
    <a href={profile.linkedin} target="_blank" rel="noreferrer"
      ><span class="eyebrow">THE PROFESSIONAL SIDE</span>
      <h3>Connect on LinkedIn ↗</h3></a
    ><a href={profile.github} target="_blank" rel="noreferrer"
      ><span class="eyebrow">THE ENGINEERING SIDE</span>
      <h3>Explore GitHub ↗</h3></a
    >
  </div></Shell
>
