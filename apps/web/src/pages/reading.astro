---
import Shell from "../layouts/Shell.astro";
import Icon from "../components/Icon.astro";
import Experience from "../components/Experience.astro";
import WritingList from "../components/WritingList.astro";
import Skills from "../components/Skills.astro";
import ContactChannels from "../components/ContactChannels.astro";
import { getContent } from "../lib/content";
const { profile, projects, experience, posts } = await getContent();
---

<Shell
  title="Recruiter view — Salman Asif, senior full-stack engineer"
  description={profile.intro}
  ><div class="reading-wrap">
    <section class="reading-hero">
      <span class="eyebrow">THE SHORT VERSION / RECRUITER VIEW</span>
      <h1>
        {profile.name}<span>Senior full-stack engineer.</span>
      </h1>
      <p>{profile.intro}</p>
      <div class="reading-proof">
        <span>{profile.experienceLabel} of product engineering</span
        ><span>{profile.collaboration.availability}</span
        ><span>{profile.collaboration.currencies} compensation</span
        ><span>English & Urdu</span>
      </div>
      <div class="hero-ctas">
        <a class="button" href="/cv"
          >View & download CV <Icon name="diagonal" size={17} /></a
        ><a class="text-link" href="/contact"
          >Get in touch <Icon name="arrow" size={17} /></a
        >
      </div>
    </section>
    <nav class="reading-nav" aria-label="Recruiter sections">
      <a href="#reading-work">Selected work</a
      ><a href="#reading-experience">Experience</a
      ><a href="#reading-skills">Skills</a
      ><a href="#reading-writing">Writing</a>
    </nav>
    <section class="reading-section" id="reading-work">
      <h2>Selected engineering work</h2>
      <div class="reading-projects">
        {projects
            .filter((p) => p.featured)
            .map((p) => (
              <a href={`/work/${p.slug}`}>
                <>
                  <div>
                    <>
                      <span class="eyebrow">
                        {p.company} / {p.status}
                      </span>
                      <h3>{p.shortTitle}</h3>
                      <p>{p.outcome}</p>
                      <div class="tags">
                        {p.stack.map((s) => (
                          <span class="tag">{s}</span>
                        ))}
                      </div>
                    </>
                  </div>
                  <Icon name="diagonal" />
                </>
              </a>
            ))}
      </div>
    </section>
    <section class="reading-section" id="reading-experience">
      <h2>Experience</h2>
      <Experience items={experience} compact />
    </section>
    <section class="reading-section" id="reading-skills">
      <h2>Skills with evidence</h2>
      <Skills projects={projects} />
    </section>
    <section class="reading-section" id="reading-writing">
      <h2>Writing</h2>
      <WritingList posts={posts} />
    </section>
    <section class="reading-section">
      <h2>Education & contact</h2>
      <p>
        BS Software Engineering · Sir Syed University of Engineering and
        Technology · 2017–2020
      </p>
      <p class="reading-location">
        Local connections: {profile.collaboration.locations}
      </p>
      <ContactChannels profile={profile} />
      <div class="contact-socials">
        <a href={`mailto:${profile.email}`}>{profile.email}</a
        ><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a
        ><a href={profile.linkedin} target="_blank" rel="noreferrer"
          >LinkedIn ↗</a
        ><button class="text-link" data-print>Print this profile</button>
      </div>
    </section>
  </div></Shell
>
