---
import Shell from "../layouts/Shell.astro";
import ContactBlock from "../components/ContactBlock.astro";
import Portrait from "../components/Portrait.astro";
import { getContent } from "../lib/content";
const { profile, site } = await getContent();
---

<Shell title={`About — ${profile.name}`} description={profile.intro}>
  <section class="page-intro about-intro">
    <div>
      <div class="eyebrow">THE HUMAN IN THE SYSTEM</div>
      <h1>I care how it works.<br>And how it <em>feels.</em></h1>
      <p>{profile.intro}</p>
    </div>
    <Portrait
      name={profile.name}
      file={site.portrait.file}
      caption={site.portrait.caption}
      priority
    />
  </section>
  <div class="about-story page-content">
    <div class="about-sidebar">
      <span class="eyebrow">LOCAL CONNECTIONS</span
      ><strong>{profile.collaboration.locations}</strong>
      <span class="eyebrow">WORKING TOGETHER</span
      ><strong>{profile.collaboration.availability}</strong>
      <span>{site.about.currentRole}<br>{site.about.currentCompany}</span>
      <span class="eyebrow">ALWAYS EXPLORING</span
      ><span
        >{site.about.interests.map((interest) => <Fragment>{interest}<br /></Fragment>)}</span
      >
    </div>
    <article class="prose">
      {site.about.sections.map((section) => <Fragment><h2>{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</Fragment>)}
      <p>
        {profile.collaboration.summary}
        Preferred compensation: {profile.collaboration.currencies}.
      </p>
      <a href="/cv" class="text-link">The complete professional story →</a>
    </article>
  </div>
  <ContactBlock profile={profile} />
</Shell>
