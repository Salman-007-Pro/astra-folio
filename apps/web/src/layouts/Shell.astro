---
import "@fontsource-variable/manrope";
import "@fontsource/dm-mono/400.css";
import "@garden/design-tokens/theme.css";
import "../styles/global.css";
import "../styles/content.css";
import "../styles/refinements.css";
import "../styles/accessibility.css";
import "../styles/responsive.css";
import "../styles/contact.css";
import "../styles/themes.css";
import "../styles/visual-styles.css";
import { visualStyles } from "../lib/visual-styles";
import Icon from "../components/Icon.astro";
import { getContent } from "../lib/content";
import { contactLinks } from "../lib/contact";
const { profile, site } = await getContent();
const contacts = contactLinks(profile);
interface Props {
  title?: string;
  description?: string;
  immersive?: boolean;
  article?: boolean;
}
const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.intro,
  immersive = false,
  article = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin)
  .href;
const links = [
  { label: "Work", href: "/work" },
  { label: "Experience", href: "/#experience" },
  { label: "Writing", href: "/writing" },
  { label: "About", href: "/about" },
  ...(site.games.enabled ? [{ label: "Play", href: "/play" }] : []),
];
const isCurrentPage = (href: string) =>
  !href.includes("#") &&
  (href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.replace(/\/$/, "") === href ||
      Astro.url.pathname.startsWith(`${href}/`));
---

<!doctype html>
<html
  lang="en"
  data-motion="on"
  data-style="default"
  data-style-options={visualStyles.map((style) => style.id).join(",")}
  data-default-palette={site.defaultPalette}
  data-palette={site.defaultPalette}
>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f3ed">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="canonical" href={canonical}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={article ? "article" : "website"}>
    <meta property="og:url" content={canonical}>
    <meta name="twitter:card" content="summary">
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name}'s field notes`}
      href="/rss.xml"
    >
    <script is:inline>
      try {
        const p = JSON.parse(
          localStorage.getItem("kinetic-garden-preferences-v1") || "{}",
        );
        const night =
          typeof p.night === "boolean"
            ? p.night
            : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.style =
          document.documentElement.dataset.styleOptions
            .split(",")
            .includes(p.style)
            ? p.style
            : "default";
        document.documentElement.dataset.theme = night ? "night" : "day";
        const palette = night ? p.darkPalette : p.lightPalette;
        document.documentElement.dataset.palette = [
          "garden",
          "ocean",
          "ember",
        ].includes(palette)
          ? palette
          : document.documentElement.dataset.defaultPalette;
        document.documentElement.dataset.motion =
          (p.motion ?? !matchMedia("(prefers-reduced-motion: reduce)").matches)
            ? "on"
            : "off";
      } catch {}
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        url: canonical,
        name: title,
        mainEntity: {
          "@type": "Person",
          name: profile.fullName,
          alternateName: profile.name,
          jobTitle: profile.role,
          url: Astro.site?.href || Astro.url.origin,
          sameAs: [profile.github, profile.linkedin],
        },
      }).replaceAll("<", "\\u003c")}
    />
    <slot name="head" />
  </head>
  <body class:list={[{ immersive }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${profile.name}, home`}
        ><span class="brand-mark">{site.brandMark}<span>↗</span></span
        ><span>{site.brandName}<span class="wordmark-dot">.</span></span></a
      >
      <nav aria-label="Main navigation" class="desktop-nav">
        {links.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrentPage(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
      </nav>
      <div class="header-actions">
        <a class="recruiter-link" href={immersive ? "/reading" : "/"}
          ><span class="mode-icon">{immersive ? "▤" : "✳"}</span>
          {immersive ? "Recruiter view" : "Explore the garden"}</a
        ><a class="contact-button" href="/contact"
          >Let’s talk <Icon name="diagonal" size={15} /></a
        ><button
          class="icon-button mobile-menu-toggle"
          aria-label="Open navigation"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-haspopup="dialog"
          data-menu-open
        >
          <Icon name="menu" />
        </button>
      </div>
    </header>
    <dialog
      id="mobile-menu"
      class="mobile-menu"
      aria-labelledby="mobile-menu-title"
    >
      <div class="drawer-header">
        <a class="wordmark" href="/" aria-label={`${profile.name}, home`}
          >{site.brandName}<span class="wordmark-dot">.</span></a
        >
        <button
          class="icon-button"
          data-dialog-close
          aria-label="Close navigation"
          autofocus
        >
          <Icon name="close" />
        </button>
      </div>
      <div class="drawer-intro">
        <span class="eyebrow">{site.title}</span>
        <h2 id="mobile-menu-title">Find your way.</h2>
      </div>
      <nav class="drawer-nav" aria-label="Mobile navigation">
        {[{ label: "Home", href: "/" }, ...links].map((link, index) => (
            <a href={link.href} aria-current={isCurrentPage(link.href) ? "page" : undefined}>
              <span class="drawer-link-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span>{link.label}</span>
              <Icon name="diagonal" size={18} />
            </a>
          ))}
      </nav>
      <div class="drawer-footer">
        <p class="drawer-availability">{profile.collaboration.availability}</p>
        <div class="drawer-actions">
          <a
            class="button"
            href={contacts.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            >WhatsApp <Icon name="message" size={16} /></a
          >
          <a class="button secondary" href={contacts.call}
            >Call me <Icon name="phone" size={16} /></a
          >
        </div>
        <div class="drawer-secondary-links">
          <a href="/contact">Contact details</a
          ><a href="/cv">View CV <Icon name="download" size={14} /></a>
        </div>
        <a class="drawer-reading-link" href="/reading"
          >Recruiter view <Icon name="arrow" size={18} /></a
        >
      </div>
    </dialog>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <a class="wordmark" href="/">{site.brandName}.</a>
      <p>{site.footer}</p>
      <div>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a
        ><a href={profile.linkedin} target="_blank" rel="noreferrer"
          >LinkedIn ↗</a
        ><a href="/rss.xml">RSS</a
        ><span class="footer-year">© {new Date().getFullYear()}</span>
      </div>
    </footer>
    <button
      class="settings-trigger"
      data-settings-open
      aria-controls="experience-settings"
      aria-haspopup="dialog"
      aria-label="Experience settings"
      title="Experience settings"
    >
      <Icon name="settings" />
      <span>Styles</span>
    </button>
    <dialog
      id="experience-settings"
      class="settings-dialog"
      aria-labelledby="settings-title"
    >
      <div class="dialog-heading">
        <span class="eyebrow">Make yourself at home</span
        ><button
          class="icon-button"
          data-dialog-close
          aria-label="Close settings"
        >
          <Icon name="close" />
        </button>
      </div>
      <h2 id="settings-title">Your kind of garden.</h2>
      <p>Ten ways to make it yours. Your choice stays with you.</p>
      <fieldset class="style-picker">
        <legend>Visual style</legend>
        <p>
          Choose a look, then explore. Light and dark palettes work with every
          style.
        </p>
        <div class="style-options">
          {visualStyles.map((style, index) => (
            <label class="style-choice" data-style-preview={style.id}>
              <input type="radio" name="visual-style" value={style.id} data-visual-style checked={style.id === "default"} />
              <span class="style-mini" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span><i></i><b>Aa</b><em></em></span>
              <strong>{style.name}</strong>
              <span class="style-description">{style.description}</span>
            </label>
          ))}
        </div>
        <p class="style-motion-note">
          Liquid Glass becomes frosted glass with motion off. Parallax adds
          depth as you scroll.
        </p>
        <button class="button style-explore" data-dialog-close>
          Explore this style <Icon name="arrow" size={16} />
        </button>
      </fieldset>
      <label class="toggle-row"
        >Motion <input type="checkbox" id="pref-motion" role="switch"></label
      ><label class="toggle-row"
        >Sound <input type="checkbox" id="pref-sound" role="switch"></label
      ><label class="toggle-row"
        >Night shift
        <input type="checkbox" id="pref-night" role="switch"></label
      ><label class="toggle-row"
        >Blueprint view
        <input type="checkbox" id="pref-blueprint" role="switch"></label
      ><a href="/reading" class="text-link"
        >Prefer a straight read? Recruiter view <Icon name="arrow" /></a
      >
      {(["day", "night"] as const).map((mode) => (
        <fieldset class="palette-picker" data-palette-picker={mode}>
          <legend>{mode === "day" ? "Light color palette" : "Dark color palette"}</legend>
          <p>Your light and dark choices are saved separately.</p>
          <div class="palette-options">
            {[{ value: "garden", label: "Garden" }, { value: "ocean", label: "Ocean" }, { value: "ember", label: "Ember" }].map((palette) => (
              <label class="palette-choice">
                <input type="radio" name={`palette-${mode}`} value={palette.value} data-palette-mode={mode} checked={site.defaultPalette === palette.value} />
                <span class="palette-preview" data-swatch={palette.value} data-swatch-mode={mode} aria-hidden="true"></span>
                <span>{palette.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
    </dialog>
    <div role="status" class="toast" id="toast"></div>
    <script src="../lib/ui.ts"></script>
  </body>
</html>
