# Production defaults. Local overrides belong in .env.local (gitignored).
# Generate PAYLOAD_SECRET with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Local .env.local should use 127.0.0.1:5434 (Docker) and http://127.0.0.1:3001.
# Northflank: set DATABASE_URL from the Postgres addon internal URI (not 127.0.0.1).
PUBLIC_SITE_URL=https://your-domain.example
CMS_PUBLIC_URL=https://cms.your-domain.example
DATABASE_URL=
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters-long
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BUILD_WEBHOOK_URL=
BUILD_WEBHOOK_SECRET=
ALLOW_SEED=false
