# Load this file from apps/cms. See docs/payload-setup.md.
# The following database is the LOCAL docker-compose.yml service only.
DATABASE_URL=postgresql://garden:garden_local_only@127.0.0.1:5432/garden
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CMS_PUBLIC_URL=http://localhost:3001
PUBLIC_SITE_URL=http://127.0.0.1:4321
# Optional Cloudflare R2 storage for hosted media
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# HTTPS build receiver; verify HMAC against timestamp + '.' + raw body
BUILD_WEBHOOK_URL=
BUILD_WEBHOOK_SECRET=
# Deliberate, one-time import into an empty development CMS. Keep false normally.
ALLOW_SEED=false
